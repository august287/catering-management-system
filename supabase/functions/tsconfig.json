{
  // Editor type-checking for the Deno Edge Functions (see deno-shims.d.ts).
  // Supabase deploys with Deno and ignores this file.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "typeRoots": ["../../node_modules/@types"],
    "types": []
  },
  "include": ["./**/*.ts"]
}
